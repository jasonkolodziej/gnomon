# /etc/gnomon/gnomon-agent.env: environment for gnomon-agent.service. Unset variables use the defaults.

# Controller(s); list every replica of a Raft group to fail over between them.
GNOMON_ADDR=http://ctl1:7631
#GNOMON_ADDR=http://ctl1:7631,http://ctl2:7631,http://ctl3:7631

# Node name (default: the hostname).
#GNOMON_NODE=node1

# Directory jobs run in and containers bind-mount; ideally a shared filesystem readable by job users.
GNOMON_WORKDIR=/shared/gnomon

# Advertise less than the detected hardware (default: all cores, memory and GPUs).
#GNOMON_CORES=32
#GNOMON_MEM_MB=128000
#GNOMON_GPUS=0

# cgroup v2 confinement: the unit sets GNOMON_CGROUP_ROOT to its own delegated cgroup.
#GNOMON_CGROUP=off

# Container jobs (gnbatch --container IMAGE): docker (default) or podman.
#GNOMON_CONTAINER_RUNTIME=docker
#GNOMON_CONTAINER_ROOTLESS=0
