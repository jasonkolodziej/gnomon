# /etc/gnomon/gnomon-ctl.env: environment for gnomon-ctl.service. Unset variables use the defaults.

# gRPC listen address (default 0.0.0.0:7631).
#GNOMON_LISTEN=0.0.0.0:7631

# How often agents heartbeat and poll for work, seconds (default 10; agents use at least 2).
#GNOMON_HEARTBEAT_SECS=10

# Seconds without a heartbeat before a node is declared lost and its jobs fail
# (default: 3 heartbeat intervals, at least 30).
#GNOMON_NODE_TIMEOUT_SECS=30

# Replicated controllers (Raft): this replica's id and the same peer list on every controller.
# Each controller also needs GNOMON_STATE_DIR (the unit sets /var/lib/gnomon).
#GNOMON_RAFT_ID=1
#GNOMON_RAFT_PEERS=1=ctl1:7700,2=ctl2:7700,3=ctl3:7700
